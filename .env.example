# These are read from *code-docker's* .env, not from this directory - this repo has no
# compose file of its own to load an .env for (see code-docker-firecrawl.yml's header).
# ootb.sh writes FIRECRAWL_TOKEN there for you (OOTB_GENERATE_SECRETS) and asks for
# FIRECRAWL_OPENAI_API_KEY once (OOTB_ENV_PROMPT_1); the rest are optional overrides.

# Shared secret firecrawl-front (the nginx proxy) checks on every request before it
# forwards anything to firecrawl-api. Generated by ootb.sh. Empty means every request
# gets 401 - there is no "auth off" mode, since Firecrawl's own self-host build has no
# key check of its own to fall back on.
FIRECRAWL_TOKEN=

# Optional - only used by the LLM-backed /extract endpoint. scrape/crawl/map work with
# this unset.
#FIRECRAWL_OPENAI_API_KEY=
#FIRECRAWL_OPENAI_BASE_URL=
#FIRECRAWL_MODEL_NAME=

# Image tags. firecrawl-api has real per-commit semver tags on ghcr.io (see
# code-docker-firecrawl.yml's comment on FIRECRAWL_TAG for how the default was picked);
# playwright-service and nuq-postgres only ever publish `latest` upstream, as of
# 2026-09-28, so there is nothing more specific to pin them to.
#FIRECRAWL_TAG=2.11.408
#FIRECRAWL_PLAYWRIGHT_TAG=latest
#FIRECRAWL_NUQ_POSTGRES_TAG=latest

# Postgres/RabbitMQ credentials for the internal nuq queue backend. Defaults match
# upstream's own self-host defaults (postgres/postgres) - the actual boundary protecting
# this data is the `firecrawl` network being unreachable from anywhere except the two
# fetchers and firecrawl-front, not this password, but overriding it costs nothing.
#FIRECRAWL_POSTGRES_USER=postgres
#FIRECRAWL_POSTGRES_PASSWORD=postgres
#FIRECRAWL_POSTGRES_DB=postgres

# Concurrency/pool tuning - upstream's own defaults, see firecrawl's own .env.example for
# what each one does.
#FIRECRAWL_NUM_WORKERS=8
#FIRECRAWL_CRAWL_CONCURRENT_REQUESTS=10
#FIRECRAWL_MAX_CONCURRENT_JOBS=5
#FIRECRAWL_BROWSER_POOL_SIZE=5

# Passed straight to playwright-service. See firecrawl's own docs for what these do -
# ALLOW_LOCAL_WEBHOOKS lets webhook URLs point at private/loopback addresses (leave
# unset unless you specifically need that), BLOCK_MEDIA drops image/font/media requests
# during rendering to save bandwidth.
#FIRECRAWL_ALLOW_LOCAL_WEBHOOKS=
#FIRECRAWL_BLOCK_MEDIA=

# Resource limits - deploy.resources.limits, same "0/unlimited" idiom code-docker's own
# CODE_CPU_LIMIT/CODE_MEM_LIMIT use. Defaults match upstream's own hardcoded
# cpus:/mem_limit: values.
#FIRECRAWL_API_CPU_LIMIT=4
#FIRECRAWL_API_MEM_LIMIT=8g
#FIRECRAWL_PLAYWRIGHT_CPU_LIMIT=2
#FIRECRAWL_PLAYWRIGHT_MEM_LIMIT=4g

# How long firecrawl-api/playwright-service wait for code-docker-netinit-docker to
# plant their default route before giving up and exiting (restart: unless-stopped then
# retries). See docker/wait-for-route.sh - both images do real network I/O at process
# startup, and the route can only be planted after the container already exists.
#FIRECRAWL_NETINIT_WAIT_TIMEOUT=60

# The `firecrawl` network's subnet and the DNS forwarder's static IP inside it - only
# need overriding if 10.89.42.0/24 collides with something else on your host. Must stay
# in sync with each other (FIRECRAWL_DNS_IP inside FIRECRAWL_SUBNET).
#FIRECRAWL_SUBNET=10.89.42.0/24
#FIRECRAWL_DNS_IP=10.89.42.2
