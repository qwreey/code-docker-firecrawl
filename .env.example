# These are read from *code-docker's* .env, not from this directory - this repo has no
# compose file of its own to load an .env for (see code-docker-firecrawl.yml's header).
# ootb.sh writes FIRECRAWL_TOKEN there for you (OOTB_GENERATE_SECRETS) and asks for
# FIRECRAWL_OPENAI_API_KEY once (OOTB_ENV_PROMPT_1); the rest are optional overrides.

# Shared secret the AIO container's own nginx-gate checks on every request before it
# forwards anything to the api harness. Generated by ootb.sh. Empty means every request
# gets 401 - there is no "auth off" mode, since Firecrawl's own self-host build has no
# key check of its own to fall back on.
FIRECRAWL_TOKEN=

# Optional - only used by the LLM-backed /extract endpoint. scrape/crawl/map work with
# this unset.
#FIRECRAWL_OPENAI_API_KEY=
#FIRECRAWL_OPENAI_BASE_URL=
#FIRECRAWL_MODEL_NAME=

# Pinned upstream git tag the image is built from (see ../Dockerfile's FIRECRAWL_REF
# build arg) - not a compose env var, set it via `docker compose build --build-arg
# FIRECRAWL_REF=vX.Y.Z` (or a build.args: entry) if you want to bump it. Firecrawl
# publishes a new semver tag on effectively every merge to main, so expect to do this by
# hand more often than a project with real GitHub Releases.

# Ports. The gate port is what code-docker's agent (and firecrawl-front) reach; the api/
# playwright ports are internal-only (127.0.0.1 inside the AIO container) and only need
# changing if they collide with something inside your own customizations.
#FIRECRAWL_GATE_PORT=3002
#FIRECRAWL_API_PORT=3902
#FIRECRAWL_PLAYWRIGHT_PORT=3000

# Postgres credentials for the internal nuq queue backend (runs inside the AIO container
# now, not a separate service). Defaults match upstream's own self-host defaults
# (postgres/postgres) - the actual boundary protecting this data is the `firecrawl`
# network being unreachable from anywhere except firecrawl-front, not this password, but
# overriding it costs nothing. Changing it after first boot does nothing on its own - see
# CLAUDE.md on the postgres init being a one-time, idempotent step.
#FIRECRAWL_POSTGRES_USER=postgres
#FIRECRAWL_POSTGRES_PASSWORD=postgres
#FIRECRAWL_POSTGRES_DB=postgres

# Concurrency/pool tuning - upstream's own defaults, see firecrawl's own .env.example for
# what each one does.
#FIRECRAWL_NUM_WORKERS=8
#FIRECRAWL_CRAWL_CONCURRENT_REQUESTS=10
#FIRECRAWL_MAX_CONCURRENT_JOBS=5
#FIRECRAWL_BROWSER_POOL_SIZE=5

# Passed straight to playwright-service. See firecrawl's own docs for what these do -
# ALLOW_LOCAL_WEBHOOKS lets webhook URLs point at private/loopback addresses (leave
# unset unless you specifically need that), BLOCK_MEDIA drops image/font/media requests
# during rendering to save bandwidth.
#FIRECRAWL_ALLOW_LOCAL_WEBHOOKS=
#FIRECRAWL_BLOCK_MEDIA=

# Resource limits - deploy.resources.limits, same "0/unlimited" idiom code-docker's own
# CODE_CPU_LIMIT/CODE_MEM_LIMIT use. One container now, so one CPU/memory budget for the
# whole thing (postgres + redis + playwright + the api harness combined) rather than
# per-service limits - defaults sized for that (sum of the old api+playwright defaults).
#FIRECRAWL_CPU_LIMIT=4
#FIRECRAWL_MEM_LIMIT=8g
