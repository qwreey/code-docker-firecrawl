# code-docker의 ootb.sh(https://github.com/qwreey/code-docker)가 이 프로젝트를
# EXTRA_INCLUDE로 자동 연동할 때 읽는 매니페스트입니다. 스키마 설명은 code-docker
# 쪽 docs/tips/ootb-manifest.md 참고. 이 파일은 plain shell env 파일로 그대로
# source되므로, 변수 대입 외의 코드는 넣지 마세요.

OOTB_NAME="Firecrawl"
OOTB_DESCRIPTION="자체 호스팅 Firecrawl (scrape/crawl-to-markdown API), 하나의 AIO 컨테이너로 실행 - code-docker 안의 에이전트가 도구로 씀. 사람이 열어보는 화면은 없음 - docs/tips/firecrawl.md 참고"
OOTB_COMPOSE_INCLUDE="code-docker-firecrawl.yml"

# 라우터의 Dev Proxy/App Routes/VNC 대상으로 등록하지 않습니다 - Firecrawl 자체 호스팅
# 빌드에는 사람이 열어볼 관리 화면이 없고, 유일한 소비자는 code-docker 안의 에이전트뿐이라
# ROUTER_EXTRA_ALLOWED_TARGET_HOSTS(=OOTB_ROUTER_ALLOWED_TARGET_HOSTS)에 넣을 호스트가
# 없습니다. router의 vhost도 안 씁니다 - 이유는 같습니다.

# 사람이 정할 게 없는 무작위 내부 토큰입니다 - AIO 컨테이너 자신의 nginx-gate가 이 값으로
# code-docker-internal에 닿는 모든 컨테이너를 걸러냅니다(Firecrawl 자체 self-host 빌드는
# 자체 키 검사가 없습니다). firecrawl-front는 이제 단순 네트워크 브릿지일 뿐, 검사는
# AIO 컨테이너 안에서 합니다. 이미 있으면(빈 값으로 꺼둔 것 포함) 건드리지 않습니다.
OOTB_GENERATE_SECRETS="FIRECRAWL_TOKEN"

# LLM 기반 /extract 엔드포인트에만 쓰이는 선택 값입니다 - 비워두면 scrape/crawl/map은
# 전부 정상 동작하고 /extract만 400을 돌려줍니다. 답이 없어도(엔터로 넘겨도) 스택은
# 정상적으로 뜨므로, "그냥 깔면 된다"를 깨뜨리지 않습니다.
OOTB_ENV_PROMPT_1="FIRECRAWL_OPENAI_API_KEY:LLM 기반 /extract 를 쓰려면 OpenAI API 키 (없으면 엔터로 건너뛰기 - scrape/crawl/map에는 영향 없음):secret"
