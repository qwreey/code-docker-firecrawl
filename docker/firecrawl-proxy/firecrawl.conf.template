# Templated by entrypoint.sh (plain sed substitution of __GATE_PORT__).
#
# `resolver` + a variable in `proxy_pass`, not a bare hostname literal - nginx only
# resolves a literal proxy_pass hostname ONCE, at worker startup, and the AIO container
# gets a new IP every time it's recreated. Same reasoning as router's own vhost nginx
# config and this repo's old firecrawl-front - see CLAUDE.md.
resolver 127.0.0.11 valid=10s;

server {
    listen __GATE_PORT__;

    location / {
        set $firecrawl_aio firecrawl;
        proxy_pass http://$firecrawl_aio:__GATE_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        client_max_body_size 50m;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
